# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
# These values are for a local development database only.

# --- PostgreSQL (used by docker compose) ---
POSTGRES_USER=yashrag
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=yashrag
POSTGRES_PORT=5432

# --- Backend ---
# Used when running the backend directly on your machine (outside Docker).
# Inside Docker Compose, DATABASE_URL is built from the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://yashrag:change-me-local-dev-only@localhost:5432/yashrag
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Published ports (docker compose) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
