# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
# These values are for a local development database only.

# --- PostgreSQL (used by docker compose) ---
POSTGRES_USER=yashrag
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=yashrag
POSTGRES_PORT=5432

# --- Backend ---
# Used when running the backend directly on your machine (outside Docker).
# Inside Docker Compose, DATABASE_URL is built from the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://yashrag:change-me-local-dev-only@localhost:5432/yashrag
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Documents (Phase 2) ---
# Maximum upload size in bytes (20 MiB).
MAX_UPLOAD_BYTES=20971520
# Where original files are stored when running outside Docker (Compose uses a named volume).
STORAGE_DIR=data/uploads

# --- Embeddings (ingestion worker, and the API for search queries) ---
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# Commit SHA (or branch or tag) on the Hugging Face Hub. Pinned to the verified BAAI/bge-m3
# commit so indexes are reproducible; `python -m app.worker prepare-model` prints what it resolved.
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# auto = Apple GPU (MPS) when available, otherwise CPU. Docker always runs on CPU.
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_SEQ_LENGTH=1024
MODEL_CACHE_DIR=data/models
# Set to true after the model is cached to stop all calls to the Hugging Face Hub.
EMBEDDING_LOCAL_FILES_ONLY=false

# --- Chunking (in model tokens) ---
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=40

# --- Search (Phase 3) ---
# Mode used when a request names none: semantic, keyword or hybrid. Semantic scored best on
# the evaluation set (docs/evaluation/README.md).
SEARCH_DEFAULT_MODE=semantic
SEARCH_DEFAULT_TOP_K=10
SEARCH_MAX_TOP_K=50
SEARCH_MAX_QUERY_CHARS=1000
# Candidates each method contributes to hybrid fusion, and the Reciprocal Rank Fusion constant.
SEARCH_FUSION_DEPTH=50
SEARCH_RRF_K=60
SEARCH_BM25_K1=1.2
SEARCH_BM25_B=0.75
SEARCH_SNIPPET_CHARS=280
# Load the embedding model in the background when the API starts instead of on the first
# semantic search. A search that arrives while the model loads waits up to
# SEARCH_MODEL_LOAD_WAIT_SECONDS; then hybrid search answers with keyword results and a
# warning, and semantic search answers 503, while the load continues.
SEARCH_PRELOAD_MODEL=true
SEARCH_MODEL_LOAD_WAIT_SECONDS=20
# Docker resource limits for the API container (it holds a copy of the model for queries).
BACKEND_MEMORY=4g
BACKEND_TORCH_THREADS=2

# --- Chat: language models (Phase 4, 4.1; docs/llm-providers.md) ---
# Keys are server-side only; never commit a real key. Configure any combination of the
# providers below. Users pick a model per question from those configured; with none, the
# Chat page says it is not configured (conversations stay readable).
#
# Default used when a question names no model. LLM_MODEL unset = first model of the list.
# The server never falls back to another provider when the chosen one fails.
LLM_PROVIDER=anthropic
# LLM_MODEL=

# Anthropic Claude (paid API).
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5

# Google Gemini (free tier or paid). Key from https://aistudio.google.com/app/apikey.
# On the free tier Google may use prompts and answers, including document passages, to
# improve its products: do not use it for confidential documents.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# free or paid: must match the billing of the key's project (it labels the models).
GEMINI_TIER=free
# GEMINI_THINKING_LEVEL=   # minimal, low, medium, high; unset = model default

# Ollama (local models). Both a URL and at least one model are needed.
# API in Docker Desktop for Mac: http://host.docker.internal:11434 (the Compose default).
# API running directly on the host: http://localhost:11434.
OLLAMA_BASE_URL=
# Allowlist; install each with `ollama pull <name>`, e.g. qwen3:8b,gemma3:12b
OLLAMA_MODELS=
OLLAMA_NUM_CTX=16384
# OLLAMA_THINK=
# OLLAMA_KEEP_ALIVE=5m
# Ollama cloud models run on ollama.com, not locally; refused unless true.
OLLAMA_ALLOW_REMOTE_MODELS=false

# Model availability checks (provider model lists, installed Ollama models).
LLM_CATALOG_TTL_SECONDS=300
LLM_CATALOG_CHECK_TIMEOUT_SECONDS=5

# Shared generation settings.
LLM_MAX_OUTPUT_TOKENS=2048
# Optional: LLM_EFFORT (Claude: low, medium, high, xhigh, max) and LLM_TEMPERATURE (sent to
# every provider; current Claude models reject it). Unset uses the model's defaults.
# LLM_EFFORT=
# LLM_TEMPERATURE=
# Claude's server-side fallback when the model declines a request: default or none.
LLM_FALLBACKS=default
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=60
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# --- Chat: retrieval, context and limits (docs/chat.md) ---
# CHAT_RETRIEVAL_MODE defaults to SEARCH_DEFAULT_MODE; CHAT_MIN_SIMILARITY is unset because
# no threshold has been calibrated.
# CHAT_RETRIEVAL_MODE=
# CHAT_MIN_SIMILARITY=
CHAT_RETRIEVAL_TOP_K=8
CHAT_MAX_QUESTION_CHARS=4000
CHAT_CONTEXT_TOKEN_BUDGET=8000
CHAT_HISTORY_TOKEN_BUDGET=3000
CHAT_HISTORY_MAX_MESSAGES=10
CHAT_FOLLOWUP_MAX_CHARS=60
CHAT_MAX_CONCURRENT_GENERATIONS=4
CHAT_CITATION_EXCERPT_CHARS=600
CHAT_HEARTBEAT_SECONDS=15

# --- Ingestion worker ---
WORKER_CONCURRENCY=1
WORKER_MAX_ATTEMPTS=3
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=15
WORKER_RETRY_BACKOFF_SECONDS=30
# Docker resource limits for the worker container.
WORKER_CPUS=4
WORKER_MEMORY=6g
WORKER_TORCH_THREADS=4

# --- S3 connectors (Phase 5; docs/connectors.md, docs/s3-setup.md) ---
# Buckets, or bucket/prefix/ scopes, that connectors may read, comma-separated. Connectors
# cannot be created while this is empty. Example: team-docs,shared-bucket/policies/
S3_ALLOWED_SOURCES=
# AWS region of the buckets (unset: AWS_REGION / AWS_DEFAULT_REGION / the profile).
S3_REGION=
# Server-side only, for an S3-compatible emulator such as MinIO; leave empty for Amazon S3.
# With the s3-local Compose profile: http://minio:9000
S3_ENDPOINT_URL=
S3_ADDRESSING_STYLE=auto
S3_MAX_OBJECT_BYTES=20971520
S3_MAX_OBJECTS_PER_SYNC=10000
CONNECTOR_SYNC_CONCURRENCY=1
CONNECTOR_SYNC_MAX_ATTEMPTS=3
CONNECTOR_SYNC_RETRY_BACKOFF_SECONDS=30
# Worker credentials: the standard AWS chain. Prefer AWS_PROFILE (with ~/.aws mounted, see
# docs/s3-setup.md) or an IAM role over long-lived keys. Never commit real keys. With the
# s3-local profile these become the keys of a read-only MinIO user (any values you choose).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_REGION=

# --- Optional MinIO emulator (docker compose --profile s3-local) ---
# Local-only administrator; at least 8 characters. Not used with Amazon S3.
MINIO_ROOT_USER=yashrag-admin
MINIO_ROOT_PASSWORD=
S3_LOCAL_BUCKET=yashrag-local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Published ports (docker compose) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
