# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
# These values are for a local development database only.

# --- PostgreSQL (used by docker compose) ---
POSTGRES_USER=yashrag
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=yashrag
POSTGRES_PORT=5432

# --- Backend ---
# Used when running the backend directly on your machine (outside Docker).
# Inside Docker Compose, DATABASE_URL is built from the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://yashrag:change-me-local-dev-only@localhost:5432/yashrag
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Documents (Phase 2) ---
# Maximum upload size in bytes (20 MiB).
MAX_UPLOAD_BYTES=20971520
# Where original files are stored when running outside Docker (Compose uses a named volume).
STORAGE_DIR=data/uploads

# --- Embeddings (ingestion worker, and the API for search queries) ---
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# Commit SHA (or branch or tag) on the Hugging Face Hub. Pinned to the verified BAAI/bge-m3
# commit so indexes are reproducible; `python -m app.worker prepare-model` prints what it resolved.
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# auto = Apple GPU (MPS) when available, otherwise CPU. Docker always runs on CPU.
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_SEQ_LENGTH=1024
MODEL_CACHE_DIR=data/models
# Set to true after the model is cached to stop all calls to the Hugging Face Hub.
EMBEDDING_LOCAL_FILES_ONLY=false

# --- Chunking (in model tokens) ---
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=40

# --- Search (Phase 3) ---
# Mode used when a request names none: semantic, keyword or hybrid. Semantic scored best on
# the evaluation set (docs/evaluation/README.md).
SEARCH_DEFAULT_MODE=semantic
SEARCH_DEFAULT_TOP_K=10
SEARCH_MAX_TOP_K=50
SEARCH_MAX_QUERY_CHARS=1000
# Candidates each method contributes to hybrid fusion, and the Reciprocal Rank Fusion constant.
SEARCH_FUSION_DEPTH=50
SEARCH_RRF_K=60
SEARCH_BM25_K1=1.2
SEARCH_BM25_B=0.75
SEARCH_SNIPPET_CHARS=280
# Load the embedding model in the background when the API starts instead of on the first
# semantic search. A search that arrives while the model loads waits up to
# SEARCH_MODEL_LOAD_WAIT_SECONDS; then hybrid search answers with keyword results and a
# warning, and semantic search answers 503, while the load continues.
SEARCH_PRELOAD_MODEL=true
SEARCH_MODEL_LOAD_WAIT_SECONDS=20
# Docker resource limits for the API container (it holds a copy of the model for queries).
BACKEND_MEMORY=4g
BACKEND_TORCH_THREADS=2

# --- Chat: language model (Phase 4) ---
# Server-side only; never commit a real key. Leave empty to run without answer generation
# (the Chat page then says it is not configured; conversations stay readable).
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_MAX_OUTPUT_TOKENS=2048
# Optional: LLM_EFFORT (low, medium, high, xhigh, max) and LLM_TEMPERATURE (only for models
# that accept it; current Claude models do not). Unset uses the model's defaults.
# LLM_EFFORT=
# LLM_TEMPERATURE=
# Server-side fallback when the model declines a request: default or none.
LLM_FALLBACKS=default
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=60
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# --- Chat: retrieval, context and limits (docs/chat.md) ---
# CHAT_RETRIEVAL_MODE defaults to SEARCH_DEFAULT_MODE; CHAT_MIN_SIMILARITY is unset because
# no threshold has been calibrated.
# CHAT_RETRIEVAL_MODE=
# CHAT_MIN_SIMILARITY=
CHAT_RETRIEVAL_TOP_K=8
CHAT_MAX_QUESTION_CHARS=4000
CHAT_CONTEXT_TOKEN_BUDGET=8000
CHAT_HISTORY_TOKEN_BUDGET=3000
CHAT_HISTORY_MAX_MESSAGES=10
CHAT_FOLLOWUP_MAX_CHARS=60
CHAT_MAX_CONCURRENT_GENERATIONS=4
CHAT_CITATION_EXCERPT_CHARS=600
CHAT_HEARTBEAT_SECONDS=15

# --- Ingestion worker ---
WORKER_CONCURRENCY=1
WORKER_MAX_ATTEMPTS=3
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=15
WORKER_RETRY_BACKOFF_SECONDS=30
# Docker resource limits for the worker container.
WORKER_CPUS=4
WORKER_MEMORY=6g
WORKER_TORCH_THREADS=4

# --- Published ports (docker compose) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
